{
  "name": "bedtime-stories",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prune-dist-masters.mjs",
    "lint": "eslint src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:body": "vitest run src/test/body-figure.test.ts src/test/body-figure-artifact.test.ts && python3 scripts/render-body-figure.py",
    "verify:wide-view": "vitest run src/test/the-wide-view.test.ts && node scripts/derive-wide-view.mjs --sheet",
    "verify:olive": "python3 scripts/verify-olive.py",
    "verify:figures": "node scripts/verify-figures.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.47.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
